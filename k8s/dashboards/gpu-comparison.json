{
  "uid": "nrp-gpu-comparison",
  "title": "NRP GPU Comparison",
  "description": "Cross-flavor GPU benchmark comparison for the NRP/Nautilus cluster. Durable results (pushed) + live telemetry (scraped).",
  "tags": [
    "nrp",
    "gpu",
    "nrpbench"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "dtype",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(nrpbench_gemm_tflops, dtype)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "bf16",
          "value": "bf16"
        },
        "label": "GEMM dtype"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU comparison matrix (best per flavor)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "description": "One row per GPU flavor. Each column is a separate instant query joined on `product` via joinByField. TFLOPS/W is computed (bf16 TFLOPS \u00f7 TDP) and is the column that matters for purchasing.",
      "targets": [
        {
          "refId": "vram",
          "expr": "max by (product) (nrpbench_gpu_vram_total_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "fp32",
          "expr": "max by (product) (nrpbench_gemm_tflops{dtype=\"fp32\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "bf16",
          "expr": "max by (product) (nrpbench_gemm_tflops{dtype=\"bf16\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "membw",
          "expr": "max by (product) (nrpbench_memory_bandwidth_gbps)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "tokens",
          "expr": "max by (product) (nrpbench_workload_tokens_per_second)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "tdp",
          "expr": "max by (product) (nrpbench_gpu_power_limit_watts)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "eff",
          "expr": "max by (product) (nrpbench_gemm_tflops{dtype=\"bf16\"}) / max by (product) (nrpbench_gpu_power_limit_watts)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "product",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "product": "GPU",
              "Value #vram": "VRAM",
              "Value #fp32": "FP32 TFLOPS",
              "Value #bf16": "BF16 TFLOPS",
              "Value #membw": "Mem BW GB/s",
              "Value #tokens": "Tokens/s",
              "Value #tdp": "TDP (W)",
              "Value #eff": "TFLOPS/W"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VRAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TDP (W)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TFLOPS/W"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "GEMM throughput \u2014 $dtype (TFLOPS)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "Square matmul TFLOPS by flavor for the selected dtype. Switch dtype with the variable at the top.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (product) (nrpbench_gemm_tflops{dtype=~\"$dtype\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{product}}"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "product",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "product",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "title": "Memory bandwidth (GB/s)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "STREAM-triad achieved bandwidth. Most research codes and all LLM inference are memory-bound \u2014 read this before TFLOPS.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (product) (nrpbench_memory_bandwidth_gbps)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{product}}"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "product",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "product",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "title": "PCIe bandwidth (GB/s)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "description": "Host<->device copy bandwidth. Gen4 x16 tops out ~25 GB/s; a much lower number means a downgraded or narrow link.",
      "targets": [
        {
          "refId": "h2d",
          "expr": "max by (product) (nrpbench_pcie_bandwidth_gbps{direction=\"h2d\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "d2h",
          "expr": "max by (product) (nrpbench_pcie_bandwidth_gbps{direction=\"d2h\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "product",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "product": "GPU",
              "Value #h2d": "Host\u2192Device",
              "Value #d2h": "Device\u2192Host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Flavors benchmarked",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 4,
        "h": 4
      },
      "description": "Distinct GPU flavors with at least one pushed result.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (product) (nrpbench_run_timestamp_seconds))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 9,
      "title": "Result freshness (age)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "description": "Wall-clock age of the newest result per flavor. Green = fresh, red = stale \u2014 re-run those flavors.",
      "targets": [
        {
          "refId": "age",
          "expr": "time() - max by (product) (nrpbench_run_timestamp_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "product": "GPU",
              "Value #age": "Age"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 604800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Live GPU utilization (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "description": "Live NVML utilization during a run. NRP expects >40% on requested GPUs (threshold line); near 100% is ideal.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (product) (nrpbench_gpu_utilization_percent)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{product}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Live power draw (W)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "description": "Live NVML power draw during a run.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (product) (nrpbench_gpu_power_watts)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{product}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Temperature (\u00b0C) & SM clock (MHz)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "description": "A sagging SM clock against rising temperature is thermal throttling \u2014 the run is a floor, not the card's ceiling.",
      "targets": [
        {
          "refId": "temp",
          "expr": "max by (product) (nrpbench_gpu_temperature_celsius)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "temp {{product}}"
        },
        {
          "refId": "clock",
          "expr": "max by (product) (nrpbench_gpu_sm_clock_mhz)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "clock {{product}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "clock"
            },
            "properties": [
              {
                "id": "unit",
                "value": "rothz"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "SM clock (MHz)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
